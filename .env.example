WEB_PORT=3000
API_PORT=8000
SHIPMENT_SERVICE_PORT=8011
NEXT_PUBLIC_SHIPMENT_SERVICE_URL=/api/services/shipment
COMPLIANCE_SERVICE_PORT=8012
NEXT_PUBLIC_COMPLIANCE_SERVICE_URL=/api/services/compliance
SHIPMENT_SERVICE_URL=http://shipment-service:8000
COMPLIANCE_SERVICE_URL=http://compliance-service:8000
INTELLIGENCE_SERVICE_URL=http://intelligence-service:8000
API_SERVICE_URL=http://api:8000
DOCUMENT_SERVICE_PORT=8013
NEXT_PUBLIC_DOCUMENT_SERVICE_URL=/api/services/document
DOCUMENT_SERVICE_URL=http://document-service:8000
DOCUMENT_SERVICE_ENABLED=true
INTELLIGENCE_SERVICE_PORT=8014
NEXT_PUBLIC_INTELLIGENCE_SERVICE_URL=/api/services/intelligence
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
HS_CONFIDENCE_THRESHOLD=0.72

POSTGRES_DB=tradetwin
POSTGRES_USER=tradetwin
POSTGRES_PASSWORD=change-me-local-postgres-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://tradetwin:change-me-local-postgres-password@postgres:5432/tradetwin

REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

NEO4J_USER=neo4j
NEO4J_PASSWORD=123456789
NEO4J_AUTH=neo4j/123456789
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_ENABLED=true

MINIO_ACCESS_KEY=tradetwin-local
MINIO_SECRET_KEY=123456789
MINIO_ROOT_USER=tradetwin-local
MINIO_ROOT_PASSWORD=123456789
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=tradetwin-documents
MINIO_SECURE=false
MINIO_ENABLED=true

NEXT_PUBLIC_API_BASE_URL=/api/services/platform
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_REQUIRED=false
TRADETWIN_VIEWER_TOKEN=local-viewer-demo-token
TRADETWIN_OPERATOR_TOKEN=local-operator-demo-token
TRADETWIN_ADMIN_TOKEN=local-admin-demo-token
NEXT_PUBLIC_DEMO_AUTH_TOKEN=local-admin-demo-token
# Profile sign-in (required by default). Register an OAuth web application first.
PROFILE_AUTH_ENABLED=true
OPERATIONAL_DEMO_ENABLED=false
# Operational evidence stays quarantined if ClamAV is unavailable.
EVIDENCE_CLAMAV_HOST=
EVIDENCE_CLAMAV_PORT=3310
APP_PUBLIC_URL=http://localhost:3000
OAUTH_PROVIDER_NAME=Google
OAUTH_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_STATE_SECRET=
# Rule sourcing: demo preserves bundled rules; reviewed uses only DB-published versions.
REGULATION_CATALOG_MODE=demo
# Optional OpenAI-compatible drafting provider; only public source text is sent.
REGULATION_LLM_BASE_URL=https://api.openai.com/v1
REGULATION_LLM_MODEL=gpt-4o-mini
REGULATION_LLM_API_KEY=
# Private product text must not leave the deployment without explicit operator opt-in.
ALLOW_PRIVATE_DATA_LLM=false
# Docker mounts .secrets/document-keyring.json only into document-service.
# Generate once with: python scripts/init-document-key.py
# DOCUMENT_ENCRYPTION_KEY_FILE=/absolute/path/to/document-keyring.json
# Optional truck routing: sends only route coordinates and vehicle dimensions.
ORS_API_KEY=
ORS_DIRECTIONS_URL=https://api.heigit.org/openrouteservice/v2/directions/driving-hgv/json
ALLOW_EXTERNAL_ROUTING=false
# Route studies send only road pins and truck/cargo dimensions to ORS; never documents.
# NON_COMMERCIAL uses Open-Meteo's public endpoint. For commercial use select COMMERCIAL
# and configure your paid Open-Meteo key. DISABLED records weather as unknown.
FREIGHT_WEATHER_PLAN=NON_COMMERCIAL
OPEN_METEO_API_KEY=
# Optional current reviewed India ADM1 GeoJSON; features require GST state_code properties.
# Blank uses geoBoundaries' attributed third-party reference and exposes its vintage.
FREIGHT_STATE_BOUNDARIES_FILE=

# Phase 3 document evidence. Government lookups remain unconfigured by default.
DOCUMENT_DEMO_ENABLED=false
DOCUMENT_OCR_ENGINE=disabled
DOCUMENT_MAX_PAGES=100
DOCUMENT_MAX_TEXT_CHARS=1000000
DOCUMENT_MAX_IMAGE_PIXELS=25000000
DOCUMENT_MAX_RENDER_PIXELS=10000000
DOCUMENT_ARITHMETIC_TOLERANCE_MINOR=1
DOCUMENT_JOB_BACKOFF_SECONDS=10
DOCUMENT_VERIFICATION_TTL_SECONDS=3600
DOCUMENT_VERIFICATION_ALLOWED_HOSTS=
# Optional server-only organisation bindings: DOCUMENT_PROVIDER_BINDING_NAME=<JSON secret config>
# Configure bindings through deployment secrets, not browser document forms.
# Docker provides DOCUMENT_WORKER_TOKEN_FILE through a private bind mount.
# Local workers may use DOCUMENT_WORKER_TOKEN_FILE=.secrets/document-worker-token

# Phase 7: server-only external generation, never restored with business data.
# Provision with: python scripts/operational-fence.py init --path <external-file>
TRADETWIN_OPERATIONAL_FENCE_FILE=
# DEVELOPMENT ONLY false preserves legacy acceptance workflows; this is not a qualified pilot.
# Set true for production protection. Recovery/admission gaps currently block qualification.
TRADETWIN_REQUIRE_QUALIFICATION=false
# Server-selected control organisations; tenant administrators cannot set this through the UI.
TRADETWIN_CONTROL_ORGANISATION_IDS=

# Server-only rule calculation strategy: FULL, SHADOW, INCREMENTAL.
# Reused calculations never carry forward dispatch permission. Default remains FULL.
COMPLIANCE_EVALUATION_MODE=FULL
