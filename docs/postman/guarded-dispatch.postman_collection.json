                  "type": "string",
                  "value": "{{preparer_token}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200',()=>pm.response.to.have.status(200));",
                  "const r=pm.response.json();const v=pm.collectionVariables;"
                ]
              }
            }
          ]
        },
