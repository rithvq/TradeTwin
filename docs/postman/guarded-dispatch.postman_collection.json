        {
          "name": "Live organisation dispatch overview",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/dispatch-dashboard",
            "header": [
              {
                "key": "X-Organization-Id",
                "value": "{{preparer_org}}"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
