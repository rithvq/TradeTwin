          "pickup_latest_at: 2, delivery_deadline_at: 4};",
          "for (const [key, days] of Object.entries(offsets)) {",
          "if (!pm.collectionVariables.get(key)) pm.collectionVariables.set(key,",
          "new Date(Date.now() + days * 86400000).toISOString()); }"
        ]
      }
    }
