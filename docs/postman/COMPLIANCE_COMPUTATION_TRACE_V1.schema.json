{
  "$defs": {
    "ComputationRuleView": {
      "additionalProperties": false,
      "properties": {
        "rule_code": {
          "title": "Rule Code",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "REUSED",
            "RECOMPUTED"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "rule_code",
        "disposition",
        "reason_codes"
      ],
      "title": "ComputationRuleView",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evaluation_id": {
      "format": "uuid",
      "title": "Evaluation Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "RECORDED",
        "NOT_RECORDED"
      ],
      "title": "Status",
      "type": "string"
    },
    "strategy": {
      "anyOf": [
        {
          "enum": [
            "FULL",
            "SHADOW",
            "INCREMENTAL"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Strategy"
    },
    "authoritative_strategy": {
      "anyOf": [
        {
          "enum": [
            "FULL",
            "INCREMENTAL"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Authoritative Strategy"
    },
    "rules_total": {
      "title": "Rules Total",
      "type": "integer"
    },
    "rules_recomputed": {
      "title": "Rules Recomputed",
      "type": "integer"
    },
    "rules_reused": {
      "title": "Rules Reused",
      "type": "integer"
    },
    "shadow_rules_reused": {
      "title": "Shadow Rules Reused",
      "type": "integer"
    },
    "shadow_equivalent": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Shadow Equivalent"
    },
    "invalidation_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Invalidation Reasons",
      "type": "array"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/ComputationRuleView"
      },
      "title": "Rules",
      "type": "array"
    },
    "permission_reused": {
      "const": false,
      "title": "Permission Reused",
      "type": "boolean"
    },
    "notice": {
      "title": "Notice",
      "type": "string"
    }
  },
  "required": [
    "evaluation_id",
    "status",
    "strategy",
    "authoritative_strategy",
    "rules_total",
    "rules_recomputed",
    "rules_reused",
    "shadow_rules_reused",
    "shadow_equivalent",
    "invalidation_reasons",
    "rules",
    "permission_reused",
    "notice"
  ],
  "title": "ComputationTraceView",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
