{
  "name": "@tradetwin/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "pretypecheck": "next typegen",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{app,components,hooks,lib,tests,types}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{app,components,hooks,lib,tests,types}/**/*.{ts,tsx}\"",
    "check:architecture": "node ../../scripts/check-web-architecture.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-query": "5.101.2",
    "@xyflow/react": "12.8.4",
    "class-variance-authority": "0.7.1",
    "leaflet": "1.9.4",
    "lucide-react": "1.42.0",
    "next": "15.5.28",
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.12",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "eslint": "9.34.0",
    "eslint-config-next": "15.5.28",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "tinypool": "2.1.2"
  }
}
